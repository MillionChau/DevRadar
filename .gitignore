# ==========================================
# DevRadar Root .gitignore
# ==========================================

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Data & Database Export Files
/data/
*.db
*.sqlite
*.sqlite3

# Logs & Temporary Files
*.log
logs/
tmp/
temp/
scratch/

# Python / AI / Quality Service / Crawler
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.pkl
*.bin

# .NET / C# Microservices (Community, Identity, Notification)
bin/
obj/
out/
.vs/
*.user
*.userosscache
*.sln.docstates

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
dist/
build/

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/